# TimePick — Docker Compose : copier ce fichier vers `.env` puis renseigner CHAQUE valeur.
#   cp .env.example .env
# Toute valeur manquante fait échouer `docker compose up` immédiatement, avec un
# message indiquant la variable en cause (échec rapide voulu — pas de demi-démarrage).

# Mot de passe du PostgreSQL interne (service `db`, jamais publié sur l'hôte).
# Caractères alphanumériques uniquement : la valeur est insérée telle quelle dans
# une URL de connexion (`@`, `:`, `/`, `%` la casseraient). Générer par exemple :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret de signature des sessions et liens de connexion (JWT). Générer :
#   openssl rand -hex 32
JWT_SECRET=

# Clé de chiffrement des secrets stockés en base (mot de passe SMTP notamment).
# EXACTEMENT 64 caractères hexadécimaux — le serveur refuse de démarrer sinon.
# Ne JAMAIS réutiliser la valeur de JWT_SECRET. Générer (exécution séparée) :
#   openssl rand -hex 32
# À sauvegarder HORS du serveur, séparément des dumps PostgreSQL : sans cette clé,
# le mot de passe SMTP contenu dans une sauvegarde restaurée est indéchiffrable.
ENCRYPTION_KEY=

# URL publique de l'instance — base des liens envoyés par email (magic links).
# En production : l'URL HTTPS finale servie par votre reverse proxy.
APP_URL=https://timepick.example.org

# Adresse d'expédition par défaut des emails.
EMAIL_FROM=noreply@timepick.example.org

# Port HTTP publié sur l'hôte (défaut : 3000). Décommenter pour changer.
# TIMEPICK_PORT=3000
