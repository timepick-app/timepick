# Requires PostgreSQL >= 16 (dashboard analytics use the 3-argument date_trunc(field, source, timezone) form).
DATABASE_URL=postgresql://user:password@localhost:5432/timepick
PORT=3000
JWT_SECRET=your_super_secret_jwt_key
# Base URL du frontend (magic links + CTA emails)
APP_URL=http://localhost:5173
EMAIL_FROM=noreply@example.com

# Encryption (32 bytes = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP — Provisionnement initial uniquement : copié en base au 1er démarrage (prepare-db),
# géré ensuite dans l'app (Paramètres → Serveur d'email). En prod, le runtime lit la base.
# En dev, fallback Mailhog (127.0.0.1:1025) si aucun SMTP configuré.
# ENCRYPTION_KEY (64 hex) requise en prod pour chiffrer le mot de passe seedé.
# Exemple : SMTP_HOST=smtp.example.org, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TimePick
SMTP_FROM_EMAIL=

# --- Test Database (required for npm test) ---
# Create server/.env.test (not committed to git) before running Jest tests.
# The test suite uses a dedicated database (timepick_test) to avoid corrupting dev data.
# It ALSO creates a second dedicated database (timepick_test_migrations) for the Jest
# "migrations" project, which isolates schema-mutating migration/rollback tests. Both
# databases are derived from the DATABASE_URL below (only the db name differs) and are
# dropped/recreated automatically by globalSetup — you do NOT declare the second one.
# Minimum required content for server/.env.test:
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timepick_test
# JWT_SECRET=test_jwt_secret_not_for_production
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# EMAIL_FROM=noreply@test.local
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# ALLOW_TEST_ROUTES=true
#
# Prerequisites:
#   1. PostgreSQL user must have CREATEDB privilege:
#      psql -c "ALTER USER postgres CREATEDB"
#   2. On older PostgreSQL installs, the uuid-ossp extension may require superuser:
#      psql -c "ALTER USER postgres SUPERUSER"
#      (or pre-install the extension into template1 once as a superuser)
#
# Optional environment variables:
#   TEST_DB_VERBOSE=1   Log test DB bootstrap output (silent by default)
