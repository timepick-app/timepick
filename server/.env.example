# PostgreSQL 16+ recommended (project's tested baseline); not enforced by the code.
DATABASE_URL=postgresql://user:password@localhost:5432/timepick
# Optionnel — auto-généré dans server/data/ si absent ; recommandé en variable d'environnement en production.
JWT_SECRET=your_super_secret_jwt_key
# Base URL du frontend (magic links + CTA emails)
APP_URL=http://localhost:5173
EMAIL_FROM=noreply@example.com

# Optionnel — auto-généré dans server/data/ si absent (32 octets = 64 hex) ; recommandé en variable d'environnement en production.
# server/data/ (ou DATA_DIR) doit être un volume persistant en production, sinon les clés générées sont perdues à chaque redéploiement.
# Encryption (32 bytes = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP — Provisionnement initial uniquement : copié en base au 1er démarrage (prepare-db),
# géré ensuite dans l'app (Paramètres → Serveur d'email). En prod, le runtime lit la base.
# En dev, repli vers un intercepteur SMTP local (127.0.0.1:1025, ex. Mailpit) si aucun SMTP configuré.
# ENCRYPTION_KEY (64 hex, optionnelle — auto-générée si absente) sert à chiffrer le mot de passe seedé.
# Exemple : SMTP_HOST=smtp.example.org, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TimePick
SMTP_FROM_EMAIL=

# ─── Fournisseur d'email HTTP (chantier email-providers) ────────────────────
# EMAIL_PROVIDER : "smtp" (défaut, cascade SMTP_* ci-dessus) | "brevo" |
# "mailjet" | "scaleway" | "sweego" | "resend" — envoi via API HTTP (pour les
# hôtes qui bloquent tout SMTP sortant, ex. Railway free). Seed one-shot en
# base au 1er démarrage, comme SMTP_* ; géré ensuite dans l'app (Paramètres →
# Serveur d'email).
# EMAIL_API_CREDENTIALS : objet JSON {champ: valeur} des credentials du
# fournisseur (champs listés par `GET /api/setup/email-providers`) — ex.
# mailjet : '{"apiKey":"...","secretKey":"..."}' ; scaleway :
# '{"secretKey":"...","projectId":"...","region":"fr-par"}'. Les champs
# secrets sont chiffrés avec ENCRYPTION_KEY (même règle que le mot de passe
# SMTP) à l'écriture en base.
# EMAIL_API_KEY : alias LEGACY mono-champ (compat, précédence : ignoré si
# EMAIL_API_CREDENTIALS est défini et valide) — équivalent à
# EMAIL_API_CREDENTIALS='{"apiKey":"..."}' — pour un provider à clé API unique
# (resend, brevo, sweego).
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_...
# EMAIL_API_CREDENTIALS={"apiKey":"ak_...","secretKey":"sk_..."}

# ─── Stockage des images d'email (chantier A) ───────────────────────────────
# STORAGE_DRIVER : "local" (défaut) = écriture disque (server/uploads, servi par
# /uploads) — chemin gratuit Oracle/Coolify, aucune configuration supplémentaire,
# comportement strictement iso-fonctionnel. "s3" = object storage S3-compatible
# (débloque Heroku, DO App Platform et tout host à FS éphémère).
STORAGE_DRIVER=local
# Requis UNIQUEMENT si STORAGE_DRIVER=s3 — le boot échoue immédiatement si l'un
# manque (fail-fast, comme les secrets) :
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com   # ou Cloudflare R2 / Scaleway / MinIO
# S3_BUCKET=timepick-emails
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Optionnels :
# S3_REGION=auto              # Cloudflare R2 exige "auto" ; Spaces/Scaleway : la région du bucket
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # défaut : <S3_ENDPOINT>/<S3_BUCKET> ; OBLIGATOIRE pour Cloudflare R2 (domaine public pub-<hash>.r2.dev ou custom — l'endpoint R2 n'est jamais public-read)
